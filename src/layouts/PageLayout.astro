---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  heading?: string;
}

const { title, description, heading } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="shell pb-20 pt-10 md:pt-16">
    <h1 class="mb-10 text-4xl font-medium leading-none tracking-tight md:mb-14 md:text-6xl">
      {heading ?? title}
    </h1>
    <slot />
  </div>
</BaseLayout>
