---
import { getLocaleFromUrl, getLocalePath, switchLocalePath, t } from '@i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const targetLocale = locale === 'en' ? 'zh' : 'en';
const pathname = Astro.url.pathname;

// Blog posts may not exist in both languages, so send those to the blog index.
const isBlogPost = /^\/(en|zh)\/blog\/.+/.test(pathname);
const label = t(locale).common.switchLanguage;
const targetPath = isBlogPost ? getLocalePath('/blog', targetLocale) : switchLocalePath(pathname, targetLocale);
---

<a
  href={targetPath}
  lang={targetLocale === 'zh' ? 'zh-CN' : 'en'}
  aria-label={label}
  title={label}
  class="flex h-8 w-8 items-center justify-center hover:text-accent"
>
  <svg class="h-[1.125rem] w-[1.125rem]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"
    />
  </svg>
</a>
