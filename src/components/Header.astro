---
import { getLocaleFromUrl, getLocalePath, t } from '@i18n/utils';
import { NAV_ITEMS, SITE } from '@lib/constants';
import LanguageSwitch from './LanguageSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const strings = t(locale);
const currentPath = Astro.url.pathname;
---

<header class:list={['z-30 w-full', overlay && 'absolute inset-x-0 top-0']}>
  <nav
    class="shell label flex h-16 items-center justify-between gap-4"
    aria-label="Primary"
  >
    <a href={getLocalePath('/', locale)} class="font-medium hover:text-accent">
      {locale === 'zh' ? SITE.titleZh : SITE.title}
    </a>
    <div class="flex items-center gap-4 sm:gap-6">
      {NAV_ITEMS.map((item) => {
        const href = getLocalePath(item.path, locale);
        const isActive = currentPath.startsWith(href);
        return (
          <a
            href={href}
            aria-current={isActive ? 'page' : undefined}
            class:list={['hover:text-accent', isActive && 'link']}
          >
            {strings.nav[item.key]}
          </a>
        );
      })}
      <div class="-mr-1.5 flex items-center">
        <LanguageSwitch />
        <ThemeToggle />
      </div>
    </div>
  </nav>
</header>
