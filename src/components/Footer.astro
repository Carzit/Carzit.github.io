---
import { getLocaleFromUrl, t } from '@i18n/utils';
import { SOCIAL } from '@lib/constants';

const strings = t(getLocaleFromUrl(Astro.url));
---

<footer class="shell label text-text-secondary">
  <div class="flex flex-wrap justify-between gap-x-8 gap-y-2 border-t border-border py-6">
    <p>{strings.common.copyright} · {strings.common.updated}</p>
    <p class="flex flex-wrap gap-x-5">
      <a href={`mailto:${SOCIAL.email}`} class="hover:text-accent">{SOCIAL.email}</a>
      <a href={SOCIAL.github} class="hover:text-accent">GitHub</a>
      <a href={SOCIAL.googleScholar} class="hover:text-accent">Google Scholar</a>
    </p>
  </div>
</footer>
